@model IReadOnlyList<Task4.Web.Models.ApplicationUser>

@{
    ViewData["Title"] = "Users";
}

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1">User management</h1>
            <p class="text-body-secondary mb-0">
                Manage registered users and their account status.
            </p>
        </div>
    </div>

    @if (TempData["Success"] is string success)
    {
        <div class="alert alert-success alert-dismissible fade show"
            role="alert">

            @success

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>

        </div>
    }

    @if (TempData["Error"] is string error)
    {
        <div class="alert alert-danger alert-dismissible fade show"
            role="alert">

            @error

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>

        </div>
    }

    <form method="post" id="userManagementForm">

        @Html.AntiForgeryToken()

        <div class="card shadow-sm">

            <div class="card-header bg-body">

                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">

                    <!--
                        Faqat "Block" matnli tugma. Unblock / Delete /
                        Delete unverified — ikonka, har biri Bootstrap
                        tooltip bilan.
                    -->
                    <div class="d-flex flex-wrap gap-2">

                        <button
                            type="submit"
                            formaction="@Url.Action("Block", "Users")"
                            class="btn btn-warning"
                            id="blockButton"
                            title="Block selected users"
                            disabled>
                            <i class="bi bi-lock-fill" aria-hidden="true"></i>
                            Block
                        </button>

                        <button
                            type="submit"
                            formaction="@Url.Action("Unblock", "Users")"
                            class="btn btn-outline-secondary"
                            id="unblockButton"
                            disabled
                            data-bs-toggle="tooltip"
                            data-bs-title="Unblock selected users"
                            title="Unblock selected users"
                            aria-label="Unblock selected users">
                            <i class="bi bi-unlock-fill" aria-hidden="true"></i>
                        </button>

                        <button
                            type="button"
                            class="btn btn-outline-danger"
                            id="deleteButton"
                            disabled
                            data-bs-toggle="modal"
                            data-bs-target="#deleteModal"
                            title="Delete selected users">
                            Delete
                        </button>

                        <button
                            type="submit"
                            formaction="@Url.Action("DeleteUnverified", "Users")"
                            class="btn btn-outline-danger"
                            data-bs-toggle="tooltip"
                            data-bs-title="Delete all unverified users"
                            title="Delete all unverified users"
                            aria-label="Delete all unverified users">
                            <i class="bi bi-person-x-fill" aria-hidden="true"></i>
                        </button>

                    </div>

                    <div class="ms-auto" style="min-width: 220px;">
                        <input
                            type="search"
                            id="filterInput"
                            class="form-control form-control-sm"
                            placeholder="Filter by name or e-mail"
                            aria-label="Filter users">
                    </div>

                </div>

            </div>

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0 user-management-table">

                    <thead>
                        <tr>

                            <th scope="col" class="text-center">
                                <input
                                    type="checkbox"
                                    class="form-check-input"
                                    id="selectAll"
                                    aria-label="Select all users">
                            </th>

                            <th scope="col">Name</th>

                            <th scope="col">E-mail</th>

                            <th scope="col">Registration</th>

                            <th scope="col">Last login</th>

                            <th scope="col">Last action</th>

                            <th scope="col">Status</th>

                            <th scope="col">Activity</th>

                        </tr>
                    </thead>

                    <tbody>

                    @foreach (var user in Model)
                    {
                        <tr class="user-row" data-filter-text="@($"{user.Name} {user.Email}".ToLowerInvariant())">

                            <td class="text-center">
                                <input
                                    type="checkbox"
                                    class="form-check-input user-checkbox"
                                    name="selectedUserIds"
                                    value="@user.Id"
                                    data-status="@user.Status"
                                    aria-label="Select @user.Name">
                            </td>

                            <td>
                                <span class="fw-medium">
                                    @user.Name
                                </span>
                            </td>

                            <td>
                                @user.Email
                            </td>

                            <td>
                                @user.RegistrationTime.ToLocalTime()
                            </td>

                            <td>
                                @(user.LastLoginTime?.ToLocalTime().ToString()
                                    ?? "Never")
                            </td>

                            <td>
                                @(user.LastActionTime?.ToLocalTime().ToString()
                                    ?? "Never")
                            </td>

                            <td>
                                @{
                                    var statusClass = user.Status switch
                                    {
                                        UserStatus.Active => "text-bg-success",
                                        UserStatus.Blocked => "text-bg-danger",
                                        UserStatus.Unverified => "text-bg-warning",
                                        _ => "text-bg-secondary"
                                    };
                                }

                                <span class="badge @statusClass user-status">
                                    @user.Status
                                </span>
                            </td>

                            <td>
                                @{
                                    var activitySummary =
                                        (IReadOnlyDictionary<string, int[]>)
                                        ViewBag.ActivitySummary;

                                    var values =
                                        activitySummary.TryGetValue(
                                            user.Id,
                                            out var activityValues)
                                            ? activityValues
                                            : new int[7];
                                }

                                <div
                                    class="activity-sparkline"
                                    data-values='@System.Text.Json.JsonSerializer.Serialize(values)'
                                    aria-label="User activity for the last seven days">
                                </div>
                            </td>
                        </tr>
                    }

                    </tbody>

                </table>

            </div>

        </div>

    </form>

    <div class="modal fade" id="deleteModal" tabindex="-1"
        aria-labelledby="deleteModalLabel" aria-hidden="true">

        <div class="modal-dialog modal-dialog-centered">

            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title" id="deleteModalLabel">
                        Delete selected users
                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Close">
                    </button>
                </div>

                <div class="modal-body">
                    <p class="mb-0">
                        Are you sure you want to delete the selected users?
                        This action cannot be undone.
                    </p>
                </div>

                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Cancel
                    </button>

                    <button type="submit"
                            form="userManagementForm"
                            formaction="@Url.Action("Delete", "Users")"
                            class="btn btn-danger">
                        Delete
                    </button>

                </div>

            </div>

        </div>
    </div>

</div>

@section Scripts
{
    <script>
        const selectAll =
            document.getElementById("selectAll");

        const checkboxes =
            document.querySelectorAll(".user-checkbox");

        const blockButton =
            document.getElementById("blockButton");

        const unblockButton =
            document.getElementById("unblockButton");

        const deleteButton =
            document.getElementById("deleteButton");

        function updateToolbar() {

            const selected =
                Array.from(
                    document.querySelectorAll(
                        ".user-checkbox:checked"
                    )
                );

            const hasSelection = selected.length > 0;

            const hasActive =
                selected.some(
                    checkbox =>
                        checkbox.dataset.status === "Active"
                );

            const hasBlocked =
                selected.some(
                    checkbox =>
                        checkbox.dataset.status === "Blocked"
                );

            blockButton.disabled =
                !hasActive;

            unblockButton.disabled =
                !hasBlocked;

            deleteButton.disabled =
                !hasSelection;
        }

        selectAll.addEventListener("change", () => {

            checkboxes.forEach(checkbox => {
                checkbox.checked = selectAll.checked;
            });

            updateToolbar();
        });

        checkboxes.forEach(checkbox => {

            checkbox.addEventListener("change", () => {

                const checkedCount =
                    document.querySelectorAll(
                        ".user-checkbox:checked"
                    ).length;

                selectAll.checked =
                    checkedCount === checkboxes.length;

                selectAll.indeterminate =
                    checkedCount > 0 &&
                    checkedCount < checkboxes.length;

                updateToolbar();
            });

        });

        updateToolbar();

        // Haqiqiy Bootstrap tooltip (title atributi emas)
        document
            .querySelectorAll('[data-bs-toggle="tooltip"]')
            .forEach(el => new bootstrap.Tooltip(el));

        // Client-side filter — faqat ko'rinishni yashiradi, ma'lumotni o'zgartirmaydi
        const filterInput =
            document.getElementById("filterInput");

        filterInput.addEventListener("input", () => {

            const term = filterInput.value.trim().toLowerCase();

            document.querySelectorAll(".user-row").forEach(row => {

                const matches =
                    row.dataset.filterText.includes(term);

                row.classList.toggle("d-none", !matches);
            });
        });

        document.querySelectorAll(".activity-sparkline")
        .forEach(container => {

            const values =
                JSON.parse(container.dataset.values);

            const width = 100;
            const height = 30;
            const padding = 2;

            const max =
                Math.max(...values, 1);

            const points = values.map((value, index) => {

                const x =
                    padding +
                    index *
                    ((width - padding * 2) /
                    (values.length - 1));

                const y =
                    height -
                    padding -
                    (value / max) *
                    (height - padding * 2);

                return `${x},${y}`;
            }).join(" ");

            container.innerHTML = `
                <svg
                    viewBox="0 0 ${width} ${height}"
                    width="100"
                    height="30"
                    role="img">

                    <polyline
                        points="${points}"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round">
                    </polyline>

                </svg>
            `;
        });
    </script>
}