@{
    ViewData["Title"] = "Login";
}

<div class="auth-page">
    <div class="container">
        <div class="auth-card">

            <div class="auth-eyebrow">Task4</div>
            <h1 class="auth-title">Sign in</h1>
            <p class="auth-subtitle">Enter your credentials to access the user management console.</p>

            <form asp-action="Login" method="post">

                <div asp-validation-summary="All" class="alert alert-danger py-2 small"></div>

                <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />

                <div class="mb-3">
                    <label for="email" class="auth-label">Email</label>
                    <div class="auth-input-group">
                        <i class="bi bi-envelope"></i>
                        <input id="email" name="email" type="email"
                               class="form-control auth-input"
                               placeholder="you@company.com" required />
                    </div>
                </div>

                <div class="mb-4">
                    <label for="password" class="auth-label">Password</label>
                    <div class="auth-input-group">
                        <i class="bi bi-lock"></i>
                        <input id="password" name="password" type="password"
                               class="form-control auth-input"
                               placeholder="••••••••" required />
                    </div>
                </div>

                <button type="submit" class="btn btn-primary auth-submit w-100">
                    Sign in
                </button>

            </form>

            <div class="auth-footer">
                Don't have an account? <a asp-action="Register">Create one</a>
            </div>

        </div>
    </div>
</div>